# ---- 依赖 ----
node_modules/

# ---- ESP-IDF 构建产物（可重新生成，勿提交）----
firmware/s3eye_imu_idf/build/
firmware/s3eye_imu_idf/sdkconfig.old
firmware/s3eye_imu_idf/managed_components/
firmware/s3eye_imu_idf/dependencies.lock

# ---- 本地私密配置（含真实 WiFi 密码，绝不提交）----
firmware/s3eye_imu_idf/main/app_config.local.h

# ---- 自然语言服务密钥（第 4 周，LLM API Key 绝不提交）----
config.local.json

# ---- 运行时数据（真实采集数据，本地保留）----
data/*.ndjson
data/records.*.ndjson
recordings/*.csv

# ---- 临时/调试文件 ----
*.log
_*.log
_idf*.log
server.log
# VPS 部署脚本创建的运行时日志目录（deploy-vps.ps1 会把 stdout/stderr 追加进去）
logs/
# 注意：test/.test-config.json 与 test/.test-nl-config.json 是测试夹具（无敏感
# 信息，被 acceptance/e2e/verify/help/storage/ws/nl/nl-config 等测试引用），必须纳入
# 版本控制 —— 否则 clone 后各测试会退回到默认配置（autoDetect=true），连上真实板子
# 产生"停采"类假失败。
#
# 但测试的运行时 DATA_DIR 是临时输出（server.js 会 mkdir 自动重建），需全部忽略。
# 这里用 test/.test-data* 通配，覆盖 .test-data / .test-data-nlcfg / .test-data-p0
# 三个目录 —— 漏掉任何一个，跑完对应测试后 git status 就会冒出未跟踪文件，
# 误 `git add .` 会把测试期配置/数据带进仓库。
test/.test-data*

# ---- 外来工具产生的垃圾目录 ----
# 某些 Windows 程序（如 NVIDIA 驱动安装 / CUDA 工具链）用相对路径创建
# "NVIDIA Corporation/umdlogs" 日志目录，会落在当时的 CWD 里。与本项目无关，
# 且未跟踪（git 不跟踪空目录）却也不被忽略，一旦程序写入文件就会污染 git status。
NVIDIA Corporation/

# ---- 系统文件 ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- Python 缓存 ----
__pycache__/
*.py[cod]

# ---- 本地备份（临时）----
*.bak.*
sdkconfig.bak*
