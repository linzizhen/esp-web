# ESP32-S3-EYE：8MB Flash，控制台走 USB Serial/JTAG（该板无 USB-UART 桥接芯片）
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# 控制台输出到内置 USB Serial/JTAG —— 这样 USB 口(COM4)既用于烧录也能看到日志与 JSON
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000

# ---- 分区表：用「大 app 分区」----
# 默认 single-app 只给 factory 1MB，加入 esp32-camera 组件后固件约 1.04MB 放不下
# （报 "app partition is too small"）。板子是 8MB flash，用 large 分区（约 1.94MB）绰绰有余。
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# 日志级别：默认 INFO
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- PSRAM：板载 8MB Octal PSRAM（ESP32-S3R8）----
# 官方指南「ESP32-S3-EYE v2.2」规格表：PSRAM = 8 MB Octal PSRAM。
# 摄像头（OV2640）的 JPEG 帧缓冲必须放在 PSRAM 里 —— 320x240 JPEG 约 10~20KB，
# 640x480 可达 50KB+，内部 RAM 装不下几帧。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- 摄像头 JPEG 帧缓冲：必须显式给足，不能按 QVGA 自动算 ----
# esp32-camera 在 cam_config() 里按【初始化时的分辨率】算缓冲：
#   AUTO 模式 → recv_size = width * height / 5 = 320*240/5 = 15360 字节
# 而运行时 set_framesize() 只改传感器寄存器，**不会重新分配缓冲**。
# 后果（2026-10-15 实测）：切到 400x296 后帧率从 6.7 掉到 1.7 帧/秒，
# 切到 640x480 直接卡死（JPEG 约 13.9KB 逼近 15360 上限，esp_camera_fb_get
# 反复失败，且 streaming 状态仍为 true，界面不报错）。
#
# 这里改为 CUSTOM 并给到 64KB：足以容纳本项目允许的最高分辨率（SVGA 800x600
# 实测 JPEG 约 15KB，留 4 倍余量），且 fb_count=2 双缓冲下 PSRAM 占用仅 128KB
# （板载 8MB Octal PSRAM，完全充裕）。
CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE_CUSTOM=y
CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE=65536
