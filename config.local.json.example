{
  "//": "自然语言服务配置（第 4 周）。复制本文件为 config.local.json 并填入真实值。该文件已被 .gitignore 忽略，密钥不会进入版本库。未配置时 NL 模块自动使用规则兜底解析，当堂验证全部可过。",
  "nlEndpoint": "https://api.deepseek.com",
  "nlApiKey": "sk-在这里填你的密钥",
  "nlModel": "deepseek-chat",
  "nlTimeoutMs": 8000,
  "//nlReplyMode": "回复文案来源。llm = 模型改写措辞（服务端会核对数字与结论，编造内容一律作废并回落模板）；template = 直接用服务端模板。留默认 llm 即可。推理型模型耗时更长，nlTimeoutMs 建议调到 15000~30000。",
  "nlReplyMode": "llm"
}
